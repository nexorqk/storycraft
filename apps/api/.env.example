NODE_ENV=development
API_PORT=3001
API_ORIGIN=http://localhost:3001
WEB_ORIGIN=http://localhost:3000

DATABASE_URL=postgresql://storycraft:storycraft@localhost:5432/storycraft?schema=public
REDIS_URL=redis://localhost:6379

GOOGLE_CLIENT_ID=replace-me
GOOGLE_CLIENT_SECRET=replace-me
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback
SESSION_SECRET=replace-me
AUTH_COOKIE_NAME=storycraft_session
AUTH_SESSION_TTL_SECONDS=2592000

# AI Generation
# Set USE_MOCK_AI=true to use mock providers for development/testing without API keys
USE_MOCK_AI=true
OPENAI_API_KEY=replace-me
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_RETRIES=3
OPENAI_TIMEOUT_MS=30000
DALLE_MODEL=dall-e-3
DALLE_SIZE=1024x1024
DALLE_QUALITY=standard
DALLE_MAX_RETRIES=3
DALLE_TIMEOUT_MS=60000
GENERATION_ENABLED=true
GENERATION_MAX_ACTIVE_JOBS_PER_USER=1
GENERATION_DAILY_JOB_LIMIT_PER_USER=10
AI_ESTIMATED_TEXT_PAGE_COST_USD=0.002
AI_ESTIMATED_IMAGE_COST_USD=0.04
AI_MAX_ESTIMATED_BOOK_COST_USD=1

# Rate Limiting
RATE_LIMIT_SHORT_TTL_SECONDS=60
RATE_LIMIT_SHORT_LIMIT=30
RATE_LIMIT_LONG_TTL_SECONDS=3600
RATE_LIMIT_LONG_LIMIT=300

S3_ENDPOINT=http://localhost:3900
S3_REGION=garage
S3_BUCKET=storycraft-local
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
S3_FORCE_PATH_STYLE=true
