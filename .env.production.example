# Copy this file to .env and replace all placeholder values.
# Do not commit .env to version control.

NODE_ENV=production

# Database and cache
DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/<dbname>?schema=public
REDIS_URL=redis://<host>:<port>

# Application origins
API_PORT=3001
API_ORIGIN=https://api.storycraftbooks.com
WEB_ORIGIN=https://storycraftbooks.com
NEXT_PUBLIC_API_URL=https://storycraftbooks.com/api

# Google OAuth
GOOGLE_CLIENT_ID=<real-google-client-id>
GOOGLE_CLIENT_SECRET=<real-google-client-secret>
GOOGLE_CALLBACK_URL=https://api.storycraftbooks.com/api/auth/google/callback

# Session
SESSION_SECRET=<high-entropy-secret-min-32-chars>
AUTH_COOKIE_NAME=storycraft_session
AUTH_SESSION_TTL_SECONDS=2592000

# AI Generation
USE_MOCK_AI=false
OPENAI_API_KEY=<real-openai-key>
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_RETRIES=3
OPENAI_TIMEOUT_MS=30000
DALLE_MODEL=dall-e-3
DALLE_SIZE=1024x1024
DALLE_QUALITY=standard
DALLE_MAX_RETRIES=3
DALLE_TIMEOUT_MS=60000

# Generation guardrails
GENERATION_ENABLED=true
GENERATION_MAX_ACTIVE_JOBS_PER_USER=1
GENERATION_DAILY_JOB_LIMIT_PER_USER=10
AI_ESTIMATED_TEXT_PAGE_COST_USD=0.002
AI_ESTIMATED_IMAGE_COST_USD=0.04
AI_MAX_ESTIMATED_BOOK_COST_USD=1

# S3-compatible storage
S3_ENDPOINT=https://s3.storycraftbooks.com
S3_REGION=<provider-region>
S3_BUCKET=<production-bucket-name>
S3_ACCESS_KEY_ID=<real-access-key>
S3_SECRET_ACCESS_KEY=<real-secret-key>
S3_FORCE_PATH_STYLE=true

# Rate limiting
RATE_LIMIT_SHORT_TTL_SECONDS=60
RATE_LIMIT_SHORT_LIMIT=30
RATE_LIMIT_LONG_TTL_SECONDS=3600
RATE_LIMIT_LONG_LIMIT=300
